@model SignupAPI.Models.GarageCustomerWithVehicleVM

@{
    ViewData["Title"] = "Add Garage Customer";
}

<form asp-action="AddUpdateGarageCustomerWithVehicle"
      asp-controller="GarageCustomers"
      method="post"
      autocomplete="off"
      class="garage-customer-form">

    @Html.AntiForgeryToken()

    <!-- ================= CUSTOMER ================= -->
    <div class="card mb-4">
        <div class="card-body">
            <section class="mb-4" aria-labelledby="customer-details-heading">
                <h2 id="customer-details-heading" class="h6 mb-3">Customer details</h2>

                <div class="row customer-form-row">
                    <div class="col-12 col-md-6">
                        <label class="form-label">First name</label>
                        <input asp-for="Customer.GarageCustomerForename" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Surname</label>
                        <input asp-for="Customer.GarageCustomerSurname" class="form-control" />
                    </div>
                </div>
            </section>

            <section class="mb-4" aria-labelledby="customer-contact-heading">
                <h2 id="customer-contact-heading" class="h6 mb-3">Contact information</h2>

                <div class="row customer-form-row">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Mobile</label>
                        <input asp-for="Customer.GarageCustomerMobileNumber" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="Customer.GarageCustomerEmailAddress" class="form-control" />
                    </div>
                </div>
            </section>

            <section aria-labelledby="customer-address-heading">
                <h2 id="customer-address-heading" class="h6 mb-3">Address details</h2>

                <div class="row customer-form-row">
                    <div class="col-12 col-md-6">
                        <label asp-for="Customer.GarageCustomerAddressline1" class="form-label">Address line 1</label>
                        <input asp-for="Customer.GarageCustomerAddressline1" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Customer.GarageCustomerAddressline2" class="form-label">Address line 2</label>
                        <input asp-for="Customer.GarageCustomerAddressline2" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Customer.GarageCustomerAddressline3" class="form-label">Address line 3</label>
                        <input asp-for="Customer.GarageCustomerAddressline3" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Customer.GarageCustomerAddressline4" class="form-label">Address line 4</label>
                        <input asp-for="Customer.GarageCustomerAddressline4" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label asp-for="Customer.GarageCustomerPostcode" class="form-label">Postcode / Eircode</label>
                        <input asp-for="Customer.GarageCustomerPostcode" class="form-control" />
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- ================= VEHICLE ================= -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="AddVehicle" id="chkAddVehicle" />
                <label class="form-check-label font-weight-bold" for="chkAddVehicle">
                    Add vehicle for this customer
                </label>
            </div>

            <div id="vehicleSection">
                <h2 class="h6 mb-3">Vehicle information</h2>

                <div class="row customer-form-row">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">Registration</label>
                        <input asp-for="Vehicle.VehicleRegistration" class="form-control registration-input customer-registration-plate" />
                    </div>
                </div>

                <div class="row customer-form-row mt-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Make</label>
                        <select id="ddlVehicleMake" asp-for="Vehicle.VehicleMakeId" class="form-control form-select"
                                asp-items="Model.ListOfVehicleMakes">
                            <option value="">-- Select make --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Model</label>
                        <select id="ddlVehicleModel" asp-for="Vehicle.VehicleModelId" class="form-control form-select"
                                asp-items="Model.ListOfVehicleModels">
                            <option value="">-- Select make --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Year</label>
                        <select asp-for="Vehicle.VehicleYearId" class="form-control form-select"
                                asp-items="Model.ListOfVehicleYears">
                            <option value="">-- Select year --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Fuel type</label>
                        <select asp-for="Vehicle.VehicleFuelTypeId" class="form-control form-select"
                                asp-items="Model.ListOfVehicleFuelTypes">
                            <option value="">-- Select fuel --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="d-flex flex-wrap align-items-center customer-form-actions">
        <button type="submit" class="btn btn-primary">
            Save
        </button>
        <a class="btn btn-light" asp-action="GarageCustomersList">Cancel</a>
    </div>
</form>

@section Scripts {

    <script type="text/javascript" src="~/js/CustomerVehicle/CustomerVehicle2.js"></script>

}
