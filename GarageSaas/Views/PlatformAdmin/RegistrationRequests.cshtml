@model GarageSaas.Models.GarageRegistrationRequestsViewModel

@{
    ViewData["Title"] = "Garage Registration Requests";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Garage Registration Requests
            </h2>

            <p class="text-muted mb-0">
                Review garages requesting access
                to GarageSaas.
            </p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <strong>Pending Requests</strong>
        </div>

        <div class="table-responsive">

            <table class="table table-hover
                align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Garage</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Requests.Any())
                    {
                        @foreach (var request
                            in Model.Requests)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @request.GarageBusinessName
                                    </strong>
                                </td>

                                <td>
                                    @request.ContactFirstName
                                    @request.ContactLastName
                                </td>

                                <td>
                                    @request.ContactEmail
                                </td>

                                <td>
                                    @request.BusinessPhone
                                </td>

                                <td>
                                    @request.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @request.Status
                                    </span>
                                </td>

                                <td class="text-end">

                                    <a asp-controller="PlatformAdmin"
                                       asp-action="RegistrationRequest"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        Review

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center
                                text-muted py-4">

                                There are currently no
                                pending registration requests.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>