@model GarageSaas.Models.GarageRegistrationRequestsViewModel

@{
    ViewData["Title"] = "Garage Registration Requests";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Garage Registration Requests
            </h2>

            <p class="text-muted mb-0">
                Review garages requesting access
                to GarageSaas.
            </p>
        </div>

    </div>

    <form asp-controller="PlatformAdmin" asp-action="RegistrationRequests" method="get"
          class="d-flex align-items-center gap-2 mb-3">
        <label for="status" class="form-label mb-0">Status</label>
        <select id="status" name="status" class="form-select w-auto">
            @foreach (var status in new[] { "Pending", "Approved", "Rejected", "Completed", "All" })
            {
                <option value="@status" selected="@(Model.SelectedStatus == status)">@status</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <strong>@Model.SelectedStatus Requests</strong>
        </div>

        <div class="table-responsive">

            <table class="table table-hover
                align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Garage</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Submitted (UTC)</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Requests.Any())
                    {
                        @foreach (var request
                            in Model.Requests)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @request.GarageBusinessName
                                    </strong>
                                </td>

                                <td>
                                    @request.ContactFirstName
                                    @request.ContactLastName
                                </td>

                                <td>
                                    @request.ContactEmail
                                </td>

                                <td>
                                    @request.BusinessPhone
                                </td>

                                <td>
                                    @request.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge @(request.Status switch { "Pending" => "bg-warning text-dark", "Approved" => "bg-primary", "Rejected" => "bg-danger", "Completed" => "bg-success", _ => "bg-secondary" })">
                                        @request.Status
                                    </span>
                                </td>

                                <td class="text-end">

                                    <a asp-controller="PlatformAdmin"
                                       asp-action="RegistrationRequest"
                                       asp-route-id="@request.Id"
                                       asp-route-status="@Model.SelectedStatus"
                                       class="btn btn-sm btn-outline-primary">

                                        @(request.Status == "Pending" ? "Review" : "View details")

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center
                                text-muted py-4">

                                @(Model.SelectedStatus == "All"
                                    ? "There are currently no registration requests."
                                    : $"There are currently no {Model.SelectedStatus.ToLowerInvariant()} registration requests.")

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
