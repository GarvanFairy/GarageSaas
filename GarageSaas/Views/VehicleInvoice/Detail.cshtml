@model GarageSaas.Services.Models.VehicleInvoiceDetailsModel

@{
    ViewData["Title"] = $"Invoice {Model?.Invoice.InvoiceNumber}";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Invoice Details</h1>
        <div class="btn-group" role="group">
            <a asp-action="AddEdit" asp-route-id="@Model.Invoice.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- ================= HEADER ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-muted">Invoice Number</h5>
                    <h3 class="mb-3">@Model?.Invoice.InvoiceNumber</h3>
                </div>
                <div class="col-md-6 text-end">
                    @switch (Model?.Invoice.InvoiceStatus)
                    {
                        case "Paid":
                            <span class="badge bg-success p-2">PAID</span>
                            break;

                        case "Pending":
                            <span class="badge bg-warning text-dark p-2">PENDING</span>
                            break;

                        case "Cancelled":
                            <span class="badge bg-danger p-2">CANCELLED</span>
                            break;

                        case "Draft":
                            <span class="badge bg-secondary p-2">DRAFT</span>
                            break;

                        default:
                            <span class="badge bg-secondary p-2">DRAFT</span>
                            break;
                    }
                </div>

                @if (Model?.Invoice != null &&
Model.Invoice.InvoiceStatus != "Paid" &&
Model.Invoice.InvoiceStatus != "Cancelled")
                {
                    <form asp-controller="VehicleInvoice"
                          asp-action="MarkAsPaid"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="invoiceId"
                               value="@Model.Invoice.Id" />

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm('Mark this invoice as paid?');">
                            Mark as Paid
                        </button>
                    </form>
                }

                @if (Model?.Invoice.InvoiceStatus == "Paid" &&
                 Model.Invoice.PaidDate.HasValue)
                {
                    <div class="col-md-3">
                        <small class="text-muted">
                            Paid Date
                        </small>

                        <p>
                            @Model.Invoice.PaidDate.Value.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                }

            </div>
            <hr />
            <div class="row">
                <div class="col-md-3">
                    <small class="text-muted">Invoice Date</small>
                    <p>@Model?.Invoice.InvoiceDate?.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Due Date</small>
                    <p>@Model?.Invoice.DateDue?.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Type</small>
                    <p>@Model?.Invoice.InvoiceType</p>
                </div>
            </div>
        </div>
    </div>



    <!-- ================= CUSTOMER & VEHICLE ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Customer & Vehicle Information</h5>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Customer Name</label>
                        <p>@(Model?.Invoice.GarageBusinessCustomer != null ? $"{Model.Invoice.GarageBusinessCustomer.GarageCustomerForename} {Model.Invoice.GarageBusinessCustomer.GarageCustomerSurname}" : "N/A")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Vehicle Make</label>
                        <p>@(Model?.Invoice.Vehicle?.VehicleMake?.Make ?? "N/A")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Vehicle Model</label>
                        <p>@(Model?.Invoice.Vehicle?.VehicleModel?.Model ?? "N/A")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Vehicle Registration</label>
                        <p>@Model?.Invoice.Vehicle?.VehicleRegistration</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <strong>Work Items</strong>
        </div>

        <div class="card-body">
            @if (Model.WorkItems != null && Model.WorkItems.Any())
            {
                foreach (var item in Model.WorkItems)
                {
                    <div class="border-bottom py-2">
                        <div>
                            @item.RepairInstructions
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">
                    No work items are associated with this invoice.
                </p>
            }
        </div>
    </div>


    <!-- ================= COSTS BREAKDOWN ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Costs Breakdown</h5>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Labour</label>
                        <p class="h6">€@Model?.Invoice.Labour?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Paint</label>
                        <p class="h6">€@Model?.Invoice.Paint?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Environment Cost</label>
                        <p class="h6">€@Model?.Invoice.EnvironmentCost?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Car Hire</label>
                        <p class="h6">€@Model?.Invoice.CarHire?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Sundry Expenses</label>
                        <p class="h6">€@Model?.Invoice.SundryExpenses?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Invoice Amount</label>
                        <p class="h6">@Model?.Invoice.InvoiceAmount</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= TOTALS ================= -->
    <div class="card shadow-sm mb-4 border-primary">
        <div class="card-body">
            <h5 class="mb-3">Totals</h5>
            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label text-muted">Sub Total</label>
                        <p class="h5">€@Model?.Invoice.SubTotal?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label text-muted">VAT (23.5%)</label>
                        <p class="h5">€@Model?.Invoice.Vat?.ToString("F2")</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label text-muted">Total</label>
                        <p class="h4 text-primary fw-bold">€@Model?.Invoice.Total?.ToString("F2")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= PAYMENT STATUS ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Payment Information</h5>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Payment Status</label>
                        <p>
                            @if (Model?.Invoice.Paid.HasValue == true && Model.Invoice.Paid.Value)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Due Date</label>
                        <p>@Model?.Invoice.DateDue?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">Paid Date</label>
                        <p>@Model?.Invoice.PaidDate?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= DESCRIPTION & COMMENTS ================= -->
    @if (!string.IsNullOrEmpty(Model?.Invoice.InvoiceDescription) || !string.IsNullOrEmpty(Model?.Invoice.Comment))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-3">Additional Information</h5>
                @if (!string.IsNullOrEmpty(Model?.Invoice.InvoiceDescription))
                {
                    <div class="mb-3">
                        <label class="form-label text-muted">Description</label>
                        <p>@Model.Invoice.InvoiceDescription</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model?.Invoice.Comment))
                {
                    <div class="mb-3">
                        <label class="form-label text-muted">Comments</label>
                        <p>@Model.Invoice.Comment</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ================= AUDIT INFO ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-muted mb-3">Audit Information</h6>
            <div class="row small">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Created:</strong> @Model?.Invoice.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model?.Invoice.CreatedBy</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1">
                        <strong>Updated:</strong> 
                        @if (Model?.Invoice.UpdatedDate.HasValue == true)
                        {
                            @Model.Invoice.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm") @("by") @Model?.Invoice.UpdatedBy
                        }
                        else
                        {
                            <span class="text-muted">Not updated</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="AddEdit" asp-route-id="@Model.Invoice.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit Invoice
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>
