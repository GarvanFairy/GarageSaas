@{
    ViewData["Title"] = "No Garage Access";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-3">
                        <i class="bi bi-shield-lock"
                           style="font-size: 3rem;"></i>
                    </div>

                    <h2 class="mb-3">
                        Garage access unavailable
                    </h2>

                    <p class="text-muted mb-4">
                        You are signed in successfully, but your
                        account does not currently have access to
                        an active garage.
                    </p>

                    <p class="text-muted">
                        If you believe you should have access,
                        please contact your garage administrator.
                    </p>

                    <a class="btn btn-outline-secondary"
                       asp-area="MicrosoftIdentity"
                       asp-controller="Account"
                       asp-action="SignOut">

                        <i class="bi bi-box-arrow-right me-1"></i>
                        Sign out

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>