@model TeamMembersViewModel

<div class="d-flex justify-content-between
    align-items-center mb-4">

    <div>
        <h2 class="mb-1">Team Members</h2>

        <p class="text-muted mb-0">
            Manage access to your garage.
        </p>
    </div>

    <a asp-controller="GarageTeam"
       asp-action="Invite"
       class="btn btn-primary">

        <i class="bi bi-person-plus me-1"></i>
        Invite Team Member

    </a>

</div>

<div class="card shadow-sm">

    <div class="card-header bg-white">
        <strong>Current team</strong>
    </div>

    <div class="table-responsive">

        <table class="table table-hover
            align-middle mb-0">

            <thead class="table-light">

                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">
                        Actions
                    </th>
                </tr>

            </thead>

            <tbody>

                @foreach (var member in Model.Members)
                {
                    <tr>

                        <td>
                            <strong>
                                @member.FirstName
                                @member.LastName
                            </strong>

                            @if (member.IsCurrentUser)
                            {
                                <span class="badge bg-light
                                    text-dark ms-1">
                                    You
                                </span>
                            }
                        </td>

                        <td>
                            @member.EmailAddress
                        </td>

                        <td>

                            @if (member.IsOwner)
                            {
                                <span class="badge bg-primary">
                                    Owner
                                </span>
                            }
                            else
                            {
                                @member.Role
                            }

                        </td>

                        <td>

                            @if (member.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    @if (Model.PendingInvitations != null &&
     Model.PendingInvitations.Any())
    {
        <div class="card shadow-sm mt-4">

            <div class="card-header bg-white">
                <strong>Invitations</strong>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Expires</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invitation
                            in Model.PendingInvitations)
                        {
                            <tr>

                                <td>
                                    @invitation.FirstName
                                    @invitation.LastName
                                </td>

                                <td>
                                    @invitation.EmailAddress
                                </td>

                                <td>
                                    @invitation.Role
                                </td>

                                <td>
                                    @if (invitation.IsExpired)
                                    {
                                        <span class="badge bg-secondary">
                                            Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (invitation.IsExpired)
                                    {
                                        <div class="text-danger fw-semibold">
                                            Expired on
                                        </div>

                                        <small class="text-muted">
                                            @invitation.ExpiresDate.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">
                                            @invitation.ExpiresIn
                                        </div>

                                        <small class="text-muted">
                                            @invitation.ExpiresDate.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">

                                        <form asp-controller="GarageTeam"
                                              asp-action="ResendInvitation"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="invitationId"
                                                   value="@invitation.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-envelope-arrow-up me-1"></i>

                                                @if (invitation.IsExpired)
                                                {
                                                    <span>Resend Invitation</span>
                                                }
                                                else
                                                {
                                                    <span>Resend</span>
                                                }

                                            </button>

                                        </form>

                                        <form asp-controller="GarageTeam"
                                              asp-action="RevokeInvitation"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="invitationId"
                                                   value="@invitation.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Revoke this invitation?');">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Revoke

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>