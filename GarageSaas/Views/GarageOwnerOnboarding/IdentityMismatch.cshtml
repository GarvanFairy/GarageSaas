@{
    ViewData["Title"] = "Account Does Not Match";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h2>
                        Account does not match invitation
                    </h2>

                    <p class="text-muted mt-3">
                        The account you signed in with does
                        not match the email address associated
                        with this GarageSaas registration.
                    </p>

                    <p class="text-muted">
                        Please sign out and use the email
                        address that received the onboarding
                        invitation.
                    </p>

                    <a asp-area="MicrosoftIdentity"
                       asp-controller="Account"
                       asp-action="SignOut"
                       class="btn btn-outline-primary mt-3">

                        Sign Out

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>