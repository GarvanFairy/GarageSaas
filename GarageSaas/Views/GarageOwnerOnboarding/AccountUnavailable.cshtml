@{
    ViewData["Title"] = "Account Unavailable";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h2>
                        GarageSaas account unavailable
                    </h2>

                    <p class="text-muted mt-3">
                        Your existing GarageSaas account
                        cannot currently be used to complete
                        this registration.
                    </p>

                    <p class="text-muted">
                        Please contact GarageSaas support
                        for assistance.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>