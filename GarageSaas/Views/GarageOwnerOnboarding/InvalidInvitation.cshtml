@{
    ViewData["Title"] = "Invalid Onboarding Invitation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h2>
                        Onboarding invitation unavailable
                    </h2>

                    <p class="text-muted mt-3">
                        This GarageSaas onboarding link is
                        invalid, expired, or is no longer active.
                    </p>

                    <p class="text-muted">
                        Please contact GarageSaas if you
                        require a new onboarding invitation.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>