@{
    ViewData["Title"] = "Existing Account";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h2>
                        Existing GarageSaas account
                    </h2>

                    <p class="text-muted mt-3">
                        An existing GarageSaas account is
                        already associated with this email
                        address but is linked to a different
                        sign-in identity.
                    </p>

                    <p class="text-muted">
                        Please contact GarageSaas support
                        before continuing with the
                        registration.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>