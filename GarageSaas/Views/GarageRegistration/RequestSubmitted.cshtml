@{
    ViewData["Title"] = "Registration Request Submitted";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h2>
                        Registration request received
                    </h2>

                    <p class="text-muted mt-3">
                        Thank you for your interest in GarageSaas.
                    </p>

                    <p class="text-muted">
                        Your garage registration request will
                        be reviewed. If approved, we'll send
                        an onboarding invitation to the email
                        address you provided.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>