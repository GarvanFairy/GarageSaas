@using System
@using System.Security.Principal
@using GarageSaas.Services
@using GarageSaas.Exceptions
@using GarageSaas.Services.Models
@inject GarageSaas.Services.Interfaces.ICurrentGarageUserService CurrentGarageUserService

@{
    CurrentGarageUserModel currentUser = null;

    
    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            currentUser = CurrentGarageUserService.GetCurrentUser();
        }
        catch (GarageAccessException)
        {
            // Authenticated B2C user may not yet have garage membership,
            // for example a platform administrator or an invited user.
            // Use the authenticated identity below for the account menu.
        }
    

    var userName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
        : User.Identity?.Name;




    if (string.IsNullOrWhiteSpace(userName) || userName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
    {
        userName = User.Identity.Name;
    }

    <div class="dropdown">
        <button class="btn btn-light account-menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="account-avatar">@(!string.IsNullOrWhiteSpace(userName) ? userName.Substring(0, 1).ToUpperInvariant() : "G")</span>
            <span class="account-name">@userName</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li>
                <form method="get" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="EditProfile">
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-person-gear me-2"></i>Profile
                    </button>
                </form>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form method="get" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right me-2"></i>Sign out
                    </button>
                </form>
            </li>
        </ul>
    </div>
    }
    }
    


