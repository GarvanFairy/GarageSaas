<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>GarageSaas-LocalDevelopment</UserSecretsId>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="5.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageReference Include="Microsoft.Identity.Web" Version="1.25.8" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="1.25.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\uploads\**\*" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Resources\Fonts\*.ttf" />
    <Content Include="Resources\Fonts\OFL.txt" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\SignupAPI\SignupAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="helpers\" />
    <Folder Include="ViewModels\" />
    <Folder Include="wwwroot\uploads\garage-logos\" />
  </ItemGroup>

</Project>
